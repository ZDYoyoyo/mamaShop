# 正式環境設定。在主機上複製成 deploy/.env 後填入實際值：
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env        # 只有自己讀得到
# deploy/.env 已被 .gitignore 排除，不會進版控。
# 值不要加引號、不要有空白；密碼類的值用 openssl rand 產生（指令寫在每一項上面）。

# ===== 網站 =====
# 使用者打開網站的網址，結尾不要加 /。
# 還沒有網域（D02）時先填主機 IP，例如 http://203.0.113.10；D04 之後改成 https://網域
SITE_URL=http://203.0.113.10

# ===== PostgreSQL =====
DB_NAME=mamashop
DB_USERNAME=mamashop
# 產生：openssl rand -hex 24
DB_PASSWORD=

# ===== JWT =====
# 產生：openssl rand -base64 48
# 外洩的話任何人都能偽造登入（包括管理員），要立刻更換（更換後所有人都要重新登入）
JWT_SECRET=
JWT_EXPIRATION=1d

# ===== 訂單通知（M01）=====
# RabbitMQ 密碼，產生：openssl rand -hex 24
RABBITMQ_PASSWORD=
# 寄信伺服器（SMTP）。還沒選好寄信服務時 MAIL_HOST 留空：不寄信，只記 log
# 選好後填入服務商提供的資料（通常 port 587、需要帳號密碼、STARTTLS）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 寄件人，要是寄信服務驗證過的網域或信箱，例如 mamaShop <no-reply@你的網域>
MAIL_FROM=

# ===== 第一個管理員 =====
# 第一次啟動時建立。之後這兩行留著也不會改到既有帳號；
# 上線前請登入後台，用「管理員」→「重設密碼」改成新密碼（D08）
ADMIN_EMAIL=
# 產生：openssl rand -base64 18
ADMIN_PASSWORD=

# ===== 選填 =====
# 對外的 HTTP port（預設 80）。只有在同一台電腦測試、80 已經被佔用時才改
# HTTP_PORT=80
