# 正式環境設定。在主機上複製成 deploy/.env 後填入實際值：
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env        # 只有自己讀得到
# deploy/.env 已被 .gitignore 排除，不會進版控。
# 值不要加引號、不要有空白；密碼類的值用 openssl rand 產生（指令寫在每一項上面）。

# ===== 網站 =====
# 使用者打開網站的網址，結尾不要加 /。
# 還沒有網域（D02）時先填主機 IP，例如 http://203.0.113.10；D04 之後改成 https://網域
SITE_URL=http://203.0.113.10

# ===== PostgreSQL =====
DB_NAME=mamashop
DB_USERNAME=mamashop
# 產生：openssl rand -hex 24
DB_PASSWORD=

# ===== JWT =====
# 產生：openssl rand -base64 48
# 外洩的話任何人都能偽造登入（包括管理員），要立刻更換（更換後所有人都要重新登入）
JWT_SECRET=
JWT_EXPIRATION=1d

# ===== 訂單通知（M01）=====
# RabbitMQ 密碼，產生：openssl rand -hex 24
RABBITMQ_PASSWORD=
# 寄信伺服器（SMTP）。還沒選好寄信服務時 MAIL_HOST 留空：不寄信，只記 log
# 選好後填入服務商提供的資料（通常 port 587、需要帳號密碼、STARTTLS）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 寄件人，要是寄信服務驗證過的網域或信箱，例如 mamaShop <no-reply@你的網域>
MAIL_FROM=

# ===== 線上付款（P01，綠界 ECPay）=====
# 還沒和綠界簽約前保持 false：結帳只有貨到付款。
# 簽約後到綠界廠商後台 → 系統開發管理 → 系統介接設定，取得下面三個值
# ⚠️ HashKey／HashIV 外洩的話，任何人都能偽造「付款成功」，和 JWT_SECRET 一樣要保密
ECPAY_ENABLED=false
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
# 正式環境的付款頁（預設就是正式環境，通常不用改）
# ECPAY_CASHIER_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5

# ===== 綠界物流（P02 超商電子地圖、P03 物流單）=====
# 和綠界申請物流服務後填入。沒開的話結帳時顧客手動填門市店號、後台手動填物流單號
ECPAY_LOGISTICS_ENABLED=false
ECPAY_LOGISTICS_MERCHANT_ID=
# 綠界廠商後台 → 系統開發管理 → 系統介接設定（物流的，和金流的不一樣）
# ⚠️ 外洩的話任何人都能偽造「已取件」通知，和 JWT_SECRET 一樣保密
ECPAY_LOGISTICS_HASH_KEY=
ECPAY_LOGISTICS_HASH_IV=
# 寄件人（印在寄件單上，未取件的包裹會退給這個人）：中文 2~5 字或英文 4~10 字，不能有數字符號
ECPAY_LOGISTICS_SENDER_NAME=
ECPAY_LOGISTICS_SENDER_CELL_PHONE=
# true：店到店（C2C）；false：大宗寄倉（B2C）。要和申請的服務一致
# ECPAY_LOGISTICS_C2C=true

# ===== 第一個管理員 =====
# 第一次啟動時建立。之後這兩行留著也不會改到既有帳號；
# 上線前請登入後台，用「管理員」→「重設密碼」改成新密碼（D08）
ADMIN_EMAIL=
# 產生：openssl rand -base64 18
ADMIN_PASSWORD=

# ===== 選填 =====
# 對外的 HTTP port（預設 80）。只有在同一台電腦測試、80 已經被佔用時才改
# HTTP_PORT=80
# 線上付款的訂單多久沒付款就自動取消（P01），預設 30 分鐘
# ORDER_PAYMENT_TIMEOUT=30m
# 宅配訂單「已送達」後多久自動完成（M02），預設 7 天。格式：7d、10d
# ORDER_AUTO_COMPLETE_AFTER=7d
