# 複製成 .env 後填入實際值：cp .env.example .env
# .env 已被 .gitignore 排除，不會進版控。
# 注意：值不要加引號，Spring 會把引號當成密碼的一部分。
# 注意：值只用英數字與符號，不要寫中文（Spring 讀這個檔案時用 ISO-8859-1 編碼，中文會變亂碼）。

# ===== Spring =====
# dev：載入本機開發設定與測試資料。正式環境不要設定這個值
APP_PROFILE=dev

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mamashop
DB_USERNAME=mamashop
DB_PASSWORD=change-me

# ===== JWT =====
# 簽章密鑰，至少 32 字元。產生方式：openssl rand -base64 48
# 正式環境一定要換成自己產生的值；外洩的話任何人都能偽造登入狀態
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# token 有效期間（預設 1d）
JWT_EXPIRATION=1d

# ===== CORS =====
# 允許呼叫 API 的前端網址（Vite 開發伺服器預設 5173），多個用逗號分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== 訂單通知（M01）=====
# RabbitMQ 的帳號密碼（docker compose 啟動 RabbitMQ 時建立；後端用同一組連線）
RABBITMQ_USERNAME=mamashop
RABBITMQ_PASSWORD=change-me-rabbitmq
# 寄信：本機用 Mailpit（docker compose up -d mailpit），信在 http://localhost:8025 看
MAIL_HOST=localhost
MAIL_PORT=1025
# 信裡「查看訂單」連結的網址
SITE_URL=http://localhost:5173

# ===== 線上付款（P01，綠界 ECPay）=====
# 下面是綠界「公開的測試商店」（綠界文件上的值，不是機密、不會真的扣款）。
# 測試信用卡：4311-9522-2222-2222，有效期限任何未來的月年，安全碼 222
# 正式環境的商店資料只放在主機的 deploy/.env，不要寫在這裡
ECPAY_ENABLED=true
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# ===== 超商電子地圖（P02，綠界物流）=====
# 綠界公開的「店到店（C2C）」測試商店代號。電子地圖不需要 HashKey
ECPAY_LOGISTICS_ENABLED=true
ECPAY_LOGISTICS_MERCHANT_ID=2000933

# ===== 預設管理員 =====
# 啟動時若此 email 尚未註冊，會自動建立一個 ADMIN 帳號。密碼至少 8 碼
# 顯示名稱預設為「管理員」（application.yml），之後可在後台修改
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

# ===== 檔案上傳 =====
# 商品圖片存放目錄（預設 ./uploads，相對於啟動時的工作目錄）
# UPLOAD_DIR=./uploads

# ===== API 文件 =====
# true：開啟 Swagger UI（http://localhost:8080/swagger-ui.html）。正式環境不要開
API_DOCS_ENABLED=true
